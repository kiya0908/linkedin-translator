/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nano-banana2",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-05-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "linkedintranslator.online",
      "custom_domain": true
    },
    {
      "pattern": "www.linkedintranslator.online",
      "custom_domain": true
    }
  ],
  // 生产环境变量已全部迁移至 Cloudflare Dashboard 手动配置
  // 本地开发使用 .dev.vars 文件
  // 注释 vars 配置以避免覆盖生产环境变量
  /*
  # 以下配置是从 wrangler.jsonc 复制的占位符配置（已注释，无效）
# .dev.vars 使用 shell 格式（KEY="VALUE"），而非 JSON 格式
# 生产环境变量请配置在 Cloudflare Dashboard
#
# "vars": {
#   // Secrets: 使用 wrangler secret put 命令配置
#   "SESSION_SECRET": "YOUR_SESSION_SECRET",
#   
    // Other Parameters
#   "CDN_URL": "https://cdn.linkedintranslator.online",
#   "DOMAIN": "https://linkedintranslator.online/",

#   "GOOGLE_ANALYTICS_ID": "G-XXXXXXX",
#   "GOOGLE_ADS_ID": "pub-xxxxxxxxxxxxxxxx",

#   // Google OAuth
#   "GOOGLE_CLIENT_ID": "YOUR_GOOGLE_CLIENT_ID",
#   "GOOGLE_CLIENT_SECRET": "YOUR_GOOGLE_CLIENT_SECRET",

#   // API Request Authorized
#   "KIEAI_APIKEY": "YOUR_KIEAI_APIKEY",

#   // Payment
#   "CREEM_STORE_ID"："sto_xxxxxxxxxxxx",
#   "CREEM_KEY": "creem_xxxxxxxxxx",
#   "CREEM_TEST_KEY": "creem_test_xxxxxxxxxx",
#   "CREEM_WEBHOOK_SECRET": "xxxxxxxxxxx",
#   // Default Values
#   "INITLIZE_CREDITS": 10,
#   "R2_ACCOUNT_ID":"cxxxxxx",
#   "R2_ACCESS_KEY_ID":"xxxxxxxxxxxxxxxx",
#   "R2_SECRET_ACCESS_KEY":"xxx"
# }
  */
  "observability": {
    "enabled": true
  },
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nanobanana2pro",
      "database_id": "97ded80b-6299-428f-940b-981357a997b0",
      "migrations_dir": "./app/.server/drizzle/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "67330c02fe5945138b03c8c9ec56e4ee"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "nanobanana2pro"
    }
  ]
}
